{
  "name": "YouTube Downloader Bot",
  "description": "A Telegram bot to download YouTube videos and audio.",
  "keywords": ["telegram", "bot", "youtube", "downloader"],
  "repository": "https://github.com/your-repo/youtube-downloader-bot",
  "buildpacks": [
    {
      "url": "heroku-community/apt"
    },
    {
      "url": "https://github.com/mxschmitt/heroku-playwright-buildpack"
    },
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "API_ID": {
      "description": "Your Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API Hash",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token",
      "required": true
    }
  }
}
